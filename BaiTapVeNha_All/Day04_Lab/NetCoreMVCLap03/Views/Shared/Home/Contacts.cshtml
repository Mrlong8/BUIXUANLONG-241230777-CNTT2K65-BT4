@{
}
<div id="contact-section" class="row my-5 align-items-center py-4">
    <div class="col-md-6 mb-4 mb-md-0">
        <div class="pe-md-4">
            <span class="badge bg-primary-subtle text-primary fw-semibold px-3 py-2 rounded-pill mb-3">Hỗ Trợ 24/7</span>
            <h2 class="fw-bold text-dark mb-3 fs-1">Liên Hệ Với Chúng Tôi</h2>
            <p class="text-muted mb-4 lead fs-6">Bạn có bất kỳ câu hỏi hoặc cần hỗ trợ thông tin về sách? Đừng ngần ngại gửi tin nhắn cho chúng tôi.</p>

            <div class="d-flex align-items-center mb-3 p-3 rounded-3 bg-light">
                <i class="bi bi-geo-alt-fill text-primary fs-3 me-3"></i>
                <div>
                    <h6 class="mb-0 fw-bold">Địa chỉ</h6>
                    <small class="text-muted">Cầu Giấy, Hà Nội, Việt Nam</small>
                </div>
            </div>
            <div class="d-flex align-items-center mb-3 p-3 rounded-3 bg-light">
                <i class="bi bi-envelope-fill text-primary fs-3 me-3"></i>
                <div>
                    <h6 class="mb-0 fw-bold">Email</h6>
                    <small class="text-muted">support@netcoremvclap03.vn</small>
                </div>
            </div>
            <div class="d-flex align-items-center p-3 rounded-3 bg-light">
                <i class="bi bi-telephone-fill text-primary fs-3 me-3"></i>
                <div>
                    <h6 class="mb-0 fw-bold">Điện thoại</h6>
                    <small class="text-muted">+84 (0) 123 456 789</small>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card contact-card p-4">
            <h4 class="fw-bold mb-4 text-center">Gửi Tin Nhắn</h4>
            <form id="contactForm">
                <div class="mb-3">
                    <label class="form-label fw-semibold">Họ và Tên</label>
                    <input type="text" class="form-control form-control-custom" placeholder="Nhập họ tên của bạn" required />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Email</label>
                    <input type="email" class="form-control form-control-custom" placeholder="name@example.com" required />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Chủ đề</label>
                    <input type="text" class="form-control form-control-custom" placeholder="Cần hỗ trợ thông tin..." />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Nội dung tin nhắn</label>
                    <textarea class="form-control form-control-custom" rows="4" placeholder="Viết nội dung tin nhắn..." required></textarea>
                </div>
                <button type="button" onclick="alert('Cảm ơn bạn đã gửi liên hệ!')" class="btn btn-primary w-100 py-3 fw-bold rounded-pill shadow">
                    <i class="bi bi-send-fill me-2"></i>Gửi Tin Nhắn
                </button>
            </form>
        </div>
    </div>
</div>