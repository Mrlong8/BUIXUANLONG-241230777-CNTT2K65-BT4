@model List<BTHLap03_ProfileAccount.Models.Product>

@{
    ViewData["Title"] = "Danh sách sản phẩm";
    var categories = ViewBag.Categories as List<BTHLap03_ProfileAccount.Models.Category>;
    int? currentCategoryId = ViewBag.CurrentCategoryId as int?;
}

<div class="container my-4">
    <div class="row">
      
        <div class="col-md-3">
            <h4 class="text-uppercase fw-bold">DANH MỤC</h4>
            <div class="list-group">
                
                <a asp-controller="Product" asp-action="Index"
                   class="list-group-item list-group-item-action @(currentCategoryId == null ? "active" : "")">
                    Tất cả sản phẩm
                </a>

         
                @if (categories != null)
                {
                    foreach (var cat in categories)
                    {
                        <a asp-controller="Product"
                           asp-action="Index"
                           asp-route-categoryId="@cat.Id"
                           class="list-group-item list-group-item-action @(currentCategoryId == cat.Id ? "active" : "")">
                            @cat.Name
                        </a>
                    }
                }
            </div>
        </div>

        <!-- CỘT BÊN PHẢI: DANH SÁCH SẢN PHẨM -->
        <div class="col-md-9">
            <h3 class="mb-3">Danh sách sản phẩm</h3>

            <div class="row">
                @if (Model.Count == 0)
                {
                    <p class="text-muted">Không có sản phẩm nào thuộc danh mục này.</p>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <div class="col-md-4 col-sm-6 mb-4">
                            <div class="card h-100 text-center p-2 shadow-sm border">
                                <img src="@Url.Content(item.Image)" class="card-img-top img-fluid" alt="@item.Name" style="height: 200px; object-fit: cover;" />
                                <div class="card-body d-flex flex-column justify-content-between p-2">
                                    <h6 class="card-title text-start fw-normal mt-2" style="min-height: 40px;">@item.Name</h6>
                                    <div class="text-start mb-2 small">
                                        @if (item.SalePrice > 0 && item.SalePrice < item.Price)
                                        {
                                            <span class="text-decoration-line-through text-muted me-1">Giá: @item.Price.ToString("N0")</span>
                                            <span class="fw-bold text-dark">Giá: @item.SalePrice.ToString("N0")</span>
                                        }
                                        else
                                        {
                                            <span class="fw-bold text-dark">Giá: @item.Price.ToString("N0")</span>
                                        }
                                    </div>
                                    <a asp-controller="Product" asp-action="Detail" asp-route-id="@item.Id" class="btn btn-success w-100 btn-sm">Chi tiết</a>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>