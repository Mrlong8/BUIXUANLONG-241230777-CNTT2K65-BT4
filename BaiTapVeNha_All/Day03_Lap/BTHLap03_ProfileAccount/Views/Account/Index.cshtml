@{
    ViewData["Title"] = "Index";
}
@model List<BTHLap03_ProfileAccount.Models.Account>

<link rel="stylesheet" href="~/css/Account.css" />

<div class="container">
    <div class="row">
        @foreach (var item in Model)
        {
            @* col-md-4 chia màn hình 12 cột thành 3 phần bằng nhau (12/4 = 3) *@
            <div class="col-md-4 col-sm-6 account-card">
                <div class="thumbnail">
                    <img src="@Url.Content(item.Avatar)" alt="@item.Name" />
                    <div class="caption">
                        <div>
                            <h3>@item.Name</h3>
                            <p>@item.Bio</p>
                        </div>
                        <p>
                            <a asp-controller="Account" asp-action="Profile" asp-route-id="@item.Id" class="btn btn-success btn-block">Profile</a>
                        </p>
                    </div>
                </div>
            </div>
        }
    </div>
</div>