@{
}
<div class="my-5">
    <div class="text-center mb-4">
        <h2 class="fw-bold text-dark">Thành Tựu Nổi Bật</h2>
        <p class="text-muted">Con số ấn tượng thể hiện sự tin tưởng của cộng đồng độc giả</p>
    </div>
    <div class="row g-4 text-center">
        <div class="col-md-3 col-6">
            <div class="stat-card">
                <i class="bi bi-journal-bookmark-fill text-primary stat-icon"></i>
                <h2 class="fw-bold text-dark mt-2 mb-0 counter" data-target="15200">0</h2>
                <p class="text-muted mb-0 fw-medium">Sách Đã Bán</p>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="stat-card">
                <i class="bi bi-people-fill text-success stat-icon"></i>
                <h2 class="fw-bold text-dark mt-2 mb-0 counter" data-target="8400">0</h2>
                <p class="text-muted mb-0 fw-medium">Độc Giả Hài Lòng</p>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="stat-card">
                <i class="bi bi-currency-dollar text-warning stat-icon"></i>
                <h2 class="fw-bold text-dark mt-2 mb-0"><span class="counter" data-target="250">0</span>K+</h2>
                <p class="text-muted mb-0 fw-medium">Doanh Thu (USD)</p>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="stat-card">
                <i class="bi bi-star-fill text-danger stat-icon"></i>
                <h2 class="fw-bold text-dark mt-2 mb-0"><span class="counter" data-target="99">0</span>%</h2>
                <p class="text-muted mb-0 fw-medium">Đánh Giá 5 Sao</p>
            </div>
        </div>
    </div>
</div>

