@{
	ViewData["Title"] = "Index";
}
@model IEnumerable<NetCoreMVCLap03.Models.Book>

<h2>Danh sách sách</h2>
<form action="" method="post" class="d-flex align-items-center gap-2" role="form">
	<div>
		<select name="AuthorId" class="form-control" asp-items="@ViewBag.authors">
			<option>Chọn Tác giả</option>
		</select>	
		<select name="GenreId" class="form-control" asp-items="@ViewBag.genres">
			<option>Chọn Thể loại</option>
		</select>
	</div>
	<button type="submit" class="btn btn-primary">Tìm kiếm</button>
	<a asp-action="Create" class="btn btn-danger">Thêm mới</a>
</form>
<hr/>

<table class="table table-bordered table-striped">
	
	<thead>
		<tr>
			<th>Id</th>
			<th>Tiêu đề</th>
			<th>Tác Giả</th>
			<th>Thể Loại</th>
			<th>Giá</th>
			<th>Hình Ảnh</th>
		</tr>
	</thead>
	<tbody>
		@foreach (var item in Model)
		{
			<tr>
				<td>@item.Id</td>
				<td>@item.Title</td>
				<td>@item.AuthorId</td>
				<td>@item.GenreId</td>
				<td>@item.Price.ToString("N0") VNĐ</td>
				<td> 
					<img src="@item.Image" alt="@item.Title" width="40"/> 
				</td>
				<td><a asp-action="Edit" class="btn btn-primary" asp-route-id="@item.Id">Sửa</a>   <a asp-action="Delete" class="btn btn-danger" asp-route-id="@item.Id">Xóa</a></td>
			</tr>
		}

</table>